// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum ProblemMode {
  CLASSIC
  WORD_ENDLESS
}

// User model for authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String? // hashed password
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  gameResults   GameResult[]

  @@index([email])
}

// Gaming results
model GameResult {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId     String
  chapter       PoolChapter @relation(fields: [chapterId], references: [id])

  wordsPerMinute Int
  accuracy       Float // 0-100
  totalCharacters Int
  correctCharacters Int
  totalTime      Int // milliseconds
  difficulty     String    @default("normal")
  zenScore       Float? // Calculated as (wordsPerMinute * accuracy / 100) for leaderboard optimization

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([zenScore(sort: Desc)])
  @@index([chapterId])
}

// Typing problem pool
model TypingProblem {
  id          String      @id @default(cuid())
  mode        ProblemMode
  problemKey  String
  display     String
  reading     String
  author      String?
  title       String?
  contentHash String
  isActive    Boolean     @default(true)
  chapterId   String
  chapter     PoolChapter @relation(fields: [chapterId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([chapterId, problemKey])
  @@unique([chapterId, contentHash])
  @@index([mode, isActive])
  @@index([mode, updatedAt(sort: Desc)])
}

// 問題プールの世代（章）。問題プールを丸ごと入れ替える際、旧プールと
// そのプレイ結果を退役させず「章」として区切って保存し、新しい章へ進む。
// isCurrent は常に1件のみtrueであることが不変条件だが、Prismaは部分ユニーク
// インデックスを表現できないため、DB制約ではなく scripts/start-new-chapter.ts
// のトランザクション内で手続き的に保証する。
model PoolChapter {
  id        String    @id @default(cuid())
  number    Int       @unique
  title     String?
  isCurrent Boolean   @default(false)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  problems  TypingProblem[]
  results   GameResult[]

  @@index([isCurrent])
}

// NextAuth accounts
model Account {
  id            String  @id @default(cuid())
  userId        String
  type          String
  provider      String
  providerAccountId String
  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth sessions
model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique
  userId        String
  expires       DateTime
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth verification tokens
model VerificationToken {
  identifier    String
  token         String    @unique
  expires       DateTime

  @@unique([identifier, token])
}
